[Unit]
Description=DWEB Mail Abuse Guard
Documentation=https://github.com/dwebserver/dweb-mail-abuse-guard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dweb-mail-abuse-guard
Group=dweb-mail-abuse-guard
SupplementaryGroups=mail
StateDirectory=dweb-mail-abuse-guard
StateDirectoryMode=0750
RuntimeDirectory=dweb-mail-abuse-guard
RuntimeDirectoryMode=0750
ExecStart=/usr/local/sbin/dweb-mail-abuse-guard run --config /etc/dweb-mail-abuse-guard/config.yml
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
UMask=0027
PrivateTmp=yes
# cPanel's sendmail wrapper and the narrowly scoped containment helper require
# their normal set-ID transitions. Do not enable NoNewPrivileges or
# RestrictSUIDSGID for this unit without moving those operations to a socket-
# activated companion service.

[Install]
WantedBy=multi-user.target
